+
+static uint64_t cmu_mux_read(void *opaque, hwaddr offset, unsigned size)
+{
+    FslIMX6CmuPin *pin = opaque;
+    return pin->mux;
+}
+
+static void cmu_mux_write(void *opaque, hwaddr offset, uint64_t value,
+                          unsigned size)
+{
+    FslIMX6CmuPin *pin = opaque;
+    /* ALT5 selects GPIO; SION enables the pad's input path for readback. */
+    pin->mux = value & 0x17;
+    pin->gpio->output_readback_mask &= ~pin->bit;
+    if (pin->mux == 0x15) {
+        pin->gpio->output_readback_mask |= pin->bit;
+    }
+}
+
+static const MemoryRegionOps cmu_mux_ops = {
+    .read = cmu_mux_read,
+    .write = cmu_mux_write,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void fsl_imx6_cmu_reset(void *opaque)
+{
+    FslIMX6State *s = FSL_IMX6(opaque);
+    if (s->experimental_cmu_gpio_readback) {
+        int i;
+        for (i = 0; i < 2; i++) {
+            cmu_mux_write(&s->cmu_pin[i], 0, 5, 4);
+        }
+    }
 }
 
