#!/bin/sh
# Shift-free USB entry. Explicit numeric actions; no action on Enter or EOF.
HERE=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd -P)
. "$HERE/common.sh"
[ "$#" = 0 ] || fail 'Usage: sh /tmp/mnt/sda1/trial (while parked)'

require_usb() {
    # A detached USB can leave its directory on CMU tmpfs. Never infer a mounted
    # destination from that directory alone or choose another connected disk.
    # Linux provides this kernel-owned table through the self/mounts symlink.
    # Read that alias; the no-symlink rule still applies to ordinary files.
    [ -f "$ROOT/proc/mounts" ] && [ -r "$ROOT/proc/mounts" ] ||
        fail 'Cannot read the kernel mount table: /proc/mounts'
    awk -v dest="$HERE" '$2==dest && $1 ~ /^\/dev\/sd[a-z]+[0-9]+$/ {found=1}
        END {exit !found}' "$ROOT/proc/mounts" ||
        fail 'Run trial from the mounted USB root; keep that USB connected.'
}

finish_and_export() {
    require_usb
    echo 'Saving current status, finishing capture (up to 15 seconds), then exporting to this USB.'
    scope_notice='Current status is not a verdict on the retained trial. A nonzero finish_exit leaves current-boot completion unconfirmed; export_exit reports retrieval separately.'
    echo "$scope_notice"
    if status_output=$(sh "$HERE/trial_status.sh" 2>&1); then status_rc=0; else status_rc=$?; fi
    if finish_output=$(sh "$HERE/finish_capture.sh" 2>&1); then finish_rc=0; else finish_rc=$?; fi
    printf 'status_scope=current_boot\n%s\nstatus_exit=%s\nfinish_scope=current_boot\n%s\nfinish_exit=%s\n' "$status_output" "$status_rc" "$finish_output" "$finish_rc"
    # An unavailable status or failed acknowledgement must not discard raw
    # evidence. Export it anyway, retaining the separate failure in the report.
    require_usb
    if export_output=$(sh "$HERE/export_logs.sh" "$HERE" 2>&1); then export_rc=0; else export_rc=$?; fi
    printf 'export_scope=all_retained_boots\n%s\nexport_exit=%s\n' "$export_output" "$export_rc"
    require_usb
    # Fixed, small report on the USB, never an accumulating log on the CMU.
    # Acquire the remount lock only after child helpers release theirs.
    ALLOW_REMOUNT=1
    mount_rw "$HERE"
    report=$HERE/trial-result.txt
    if [ -e "$report" ] || [ -L "$report" ]; then regular "$report"; fi
    printf '%s\nstatus_scope=current_boot\n%s\nstatus_exit=%s\nfinish_scope=current_boot\n%s\nfinish_exit=%s\nexport_scope=all_retained_boots\n%s\nexport_exit=%s\n' \
        "$scope_notice" "$status_output" "$status_rc" "$finish_output" "$finish_rc" \
        "$export_output" "$export_rc" > "$report" || fail 'Cannot save USB report; retain the displayed result.'
    sync
    echo "Result saved: $report"
    [ "$export_rc" = 0 ] || return "$export_rc"
    [ "$finish_rc" = 0 ] || return "$finish_rc"
    echo 'Capture finish acknowledged and available logs exported. Power off normally without reinstalling or rearming.'
}

last_rc=0
while :; do
    printf '\n%s\n' 'Parked USB trial menu' \
        '1 Install for the next boot' \
        '2 Optional current status and retained record summary' \
        '3 Finish capture and save logs to this USB' \
        '4 Uninstall (keeps collected logs)' \
        '0 Exit'
    echo 'Capture starts automatically on the armed boot; menu 2 is not required. With one USB port, disconnect AA while parked, reconnect this USB, then choose 3.'
    printf 'Number, then Enter: '
    if ! IFS= read -r choice; then exit "$last_rc"; fi
    case "$choice" in
        1) sh "$HERE/install.sh"; exit 0;;
        2) if sh "$HERE/trial_status.sh"; then last_rc=0; else last_rc=$?; fi
           echo "status_exit=$last_rc";;
        3) finish_and_export; exit 0;;
        4) sh "$HERE/uninstall.sh"; exit 0;;
        0) exit "$last_rc";;
        *) echo 'Enter one of the listed numbers; no action taken.';;
    esac
done
