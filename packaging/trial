        echo 'Not changed here; menu 6 removes it.'
        return 0
    fi
    if [ -e "$marker" ] || [ -L "$marker" ]; then state=OFF; next=ON
    else state=ON; next=OFF; fi
    printf '%s\n' "Heading log (G3) now: $state" \
        'Off: no heading log, no start bearing.' \
        "Enter 8 again to switch it $next," \
        'anything else cancels.'
    printf 'Number, then Enter: '
    if ! IFS= read -r confirm; then echo 'Cancelled; nothing changed.'; return 1; fi
    if [ "$confirm" != 8 ]; then echo 'Cancelled; nothing changed.'; return 0; fi
    if [ "$next" = OFF ]; then
        marker_tmp=$BASE/g3-off.new.$$
        rm -f "$marker_tmp" || fail 'Cannot stage the g3-off marker'
        if ! printf 'off\n' > "$marker_tmp" || ! mv -f "$marker_tmp" "$marker"; then
            rm -f "$marker_tmp" || :
            fail 'Cannot write the g3-off marker'
        fi
    else
        rm -f "$marker" || fail 'Cannot remove the g3-off marker'
    fi
    sync
    echo "Heading log set to $next."
    echo 'Read once at CMU start: choose 5'
    echo '(parked reboot) for it to take effect.'
    return 0
}

# Menu 9 (2026-10-12, validation/DIAG_BUILD_A20_S5_2026-10-12.md): the
# owner switch of the diagnostic tunnel test. While BASE/diag holds exactly
# "on" the BETA worker gives every GPS-lost episode one hidden test arm;
# absent or anything else is the normal BETA. Read once at CMU start. Never
# touches mx5dr.conf. Shows the state first, then one numeric confirmation
# (9 again). The arm of a tunnel is never shown here (blind test).
diag_toggle() {
    marker=$BASE/diag
    if [ ! -d "$BASE" ] || [ -L "$BASE" ]; then
        echo 'Tunnel test: package not installed;'
        echo 'nothing changed.'
        return 0
    fi
    if [ -d "$marker" ] && [ ! -L "$marker" ]; then
        echo 'Tunnel test: OFF (diag is a dir).'
        echo 'Not changed here; menu 6 removes it.'
        return 0
    fi
    state=OFF; next=ON
    if [ -f "$marker" ] && [ ! -L "$marker" ] && [ "$(wc -c < "$marker")" -eq 3 ] &&
       printf 'on\n' | cmp -s - "$marker"; then state=ON; next=OFF
    elif [ -e "$marker" ] || [ -L "$marker" ]; then state='OFF (invalid marker)'; next=ON; fi
    printf '%s\n' "Tunnel test now: $state" \
        'BETA only: each tunnel gets a hidden' \
        'setting. Note grey/frozen per tunnel.' \
        "Enter 9 again to switch it $next," \
        'anything else cancels.'
    printf 'Number, then Enter: '
    if ! IFS= read -r confirm; then echo 'Cancelled; nothing changed.'; return 1; fi
    if [ "$confirm" != 9 ]; then echo 'Cancelled; nothing changed.'; return 0; fi
    if [ "$next" = ON ]; then
        marker_tmp=$BASE/diag.new.$$
        rm -f "$marker_tmp" || fail 'Cannot stage the diag marker'
        # An invalid marker (a symlink, even to a directory) is removed itself
        # first: mv would otherwise move the file INTO a symlinked directory.
        if [ -L "$marker" ]; then rm -f "$marker" || fail 'Cannot remove the invalid diag marker'; fi
        if ! printf 'on\n' > "$marker_tmp" || ! mv -f "$marker_tmp" "$marker"; then
            rm -f "$marker_tmp" || :
            fail 'Cannot write the diag marker'
        fi
    else
        rm -f "$marker" || fail 'Cannot remove the diag marker'
    fi
    sync
    echo "Tunnel test set to $next."
    echo 'Read once at CMU start: choose 5'
    echo '(parked reboot) for it to take effect.'
    return 0
}

# Menu 10 (2026-10-12, validation/TUNNEL_REPORT_CAP_2026-10-12.md): the
# owner switch of the BETA tunnel accuracy ceiling (25 m, the product
# default). While BASE/acc-cap-off exists (any type) the BETA worker reports
# the beta.12 values (40 m ceiling, 25 m only when stopped); read once at CMU
# start. Never touches mx5dr.conf. Shows the state first, then one numeric
# confirmation (10 again).
acc_cap_toggle() {
    marker=$BASE/acc-cap-off
    if [ ! -d "$BASE" ] || [ -L "$BASE" ]; then
        echo 'Tunnel 25 m cap: package not installed;'
        echo 'nothing changed.'
        return 0
    fi
    if [ -d "$marker" ] && [ ! -L "$marker" ]; then
        echo 'Tunnel 25 m cap: OFF (marker is a dir).'
        echo 'Not changed here; menu 6 removes it.'
        return 0
    fi
    if [ -e "$marker" ] || [ -L "$marker" ]; then state=OFF; next=ON
    else state=ON; next=OFF; fi
    printf '%s\n' "Tunnel 25 m cap now: $state" \
        'BETA only. OFF = old 40 m tunnel value.' \
        "Enter 10 again to switch it $next," \
        'anything else cancels.'
    printf 'Number, then Enter: '
    if ! IFS= read -r confirm; then echo 'Cancelled; nothing changed.'; return 1; fi
    if [ "$confirm" != 10 ]; then echo 'Cancelled; nothing changed.'; return 0; fi
    if [ "$next" = OFF ]; then
        marker_tmp=$BASE/acc-cap-off.new.$$
        rm -f "$marker_tmp" || fail 'Cannot stage the acc-cap-off marker'
        if ! printf 'off\n' > "$marker_tmp" || ! mv -f "$marker_tmp" "$marker"; then
            rm -f "$marker_tmp" || :
            fail 'Cannot write the acc-cap-off marker'
        fi
    else
        # The marker itself (also a symlink, even to a directory) is removed;
        # nothing is written through it.
        rm -f "$marker" || fail 'Cannot remove the acc-cap-off marker'
    fi
    sync
    echo "Tunnel 25 m cap set to $next."
    echo 'Read once at CMU start: choose 5'
    echo '(parked reboot) for it to take effect.'
    return 0
}

# Menu 11 (2026-10-14, validation/PHONE_IMU_CHANNEL_2026-10-14.md): the
# owner switch of the phone IMU Bluetooth service (record only, default on).
# While BASE/bt-off exists (any type) the guard starts bds with the stock
# arguments and the collector starts no receiver; read at CMU start. Never
# touches mx5dr.conf. Shows the state first, then one numeric confirmation
# (11 again). Menu 1 clears it, like the automatic bt-fail records.
bt_toggle() {
    marker=$BASE/bt-off
    if [ ! -d "$BASE" ] || [ -L "$BASE" ]; then
        echo 'Phone IMU Bluetooth: package not'
        echo 'installed; nothing changed.'
        return 0
    fi
    if [ -d "$marker" ] && [ ! -L "$marker" ]; then
        echo 'Phone IMU Bluetooth: OFF (marker dir).'
        echo 'Not changed here; menu 6 removes it.'
        return 0
    fi
    if [ -e "$marker" ] || [ -L "$marker" ]; then state=OFF; next=ON
    else state=ON; next=OFF; fi
    printf '%s\n' "Phone IMU Bluetooth now: $state" \
        'Record only; BETA and LOCATION same.' \
        "Enter 11 again to switch it $next," \
        'anything else cancels.'
    printf 'Number, then Enter: '
    if ! IFS= read -r confirm; then echo 'Cancelled; nothing changed.'; return 1; fi
    if [ "$confirm" != 11 ]; then echo 'Cancelled; nothing changed.'; return 0; fi
    if [ "$next" = OFF ]; then
        marker_tmp=$BASE/bt-off.new.$$
        rm -f "$marker_tmp" || fail 'Cannot stage the bt-off marker'
        if ! printf 'off\n' > "$marker_tmp" || ! mv -f "$marker_tmp" "$marker"; then
            rm -f "$marker_tmp" || :
            fail 'Cannot write the bt-off marker'
        fi
    else
        # The marker itself (also a symlink) is removed; nothing is written
        # through it.
        rm -f "$marker" || fail 'Cannot remove the bt-off marker'
    fi
    sync
    echo "Phone IMU Bluetooth set to $next."
    echo 'Read once at CMU start: choose 5'
    echo '(parked reboot) for it to take effect.'
    return 0
}

# Display only: install.sh validates the same marker again before any write.
bundle_mode() {
    marker=$HERE/bundle-default-mode
    if [ ! -e "$marker" ] && [ ! -L "$marker" ]; then echo OBSERVE; return 0; fi
    if [ -f "$marker" ] && [ ! -L "$marker" ] && [ "$(wc -c < "$marker")" -le 8 ]; then
        awk 'NR==1 && ($0=="OBSERVE" || $0=="SHADOW" || $0=="BETA") {mode=$0}
            END {if(NR!=1 || mode=="") print "invalid"; else print mode}' "$marker"
    else
        echo invalid
    fi
}
BUNDLE_MODE=$(bundle_mode)
case "$BUNDLE_MODE" in
    BETA) mode_text='BETA = SHADOW capture + dead-reckoned LOCATION only while GPS is lost';;
    SHADOW) mode_text='SHADOW = capture only; LOCATION is never replaced';;
    OBSERVE) mode_text='OBSERVE = observation only; LOCATION is never replaced';;
    *) mode_text='invalid bundle mode; menu 1 will refuse to install';;
esac
# BETA installs the persistent product (every boot); others stay one-boot.
install_text="1 Install $BUNDLE_MODE for the next boot"
start_text='After install choose 5; keep this USB connected. After restart reopen this menu and choose 2 before switching to AA. For recovery choose 3 without reinstalling or rearming.'
installed_text='Installation finished. Choose 5 to request a CMU reboot; ignition off/on is not a reboot check.'
if [ "$BUNDLE_MODE" = BETA ]; then
    install_text='1 Install or re-enable BETA, every boot'
    start_text='BETA runs on every boot once installed. After install choose 5 once, then 2 before switching to AA. 2 shows status, 3 saves logs, 4 removes BETA; after 4 and a reboot with 5, 6 deletes every file it left.'
    installed_text='Installation finished. Choose 5 to start the first BETA boot; later boots start it by themselves.'
fi
last_rc=0
short_menu=0
while :; do
    if [ "$short_menu" = 1 ]; then
        short_menu=0
        printf '\n%s\n' '0 Exit (1-11 as listed before)'
    else
        printf '\n%s\n' 'Parked USB trial menu' \
            "This USB installs mode $BUNDLE_MODE: $mode_text" \
            "$install_text" \
            '2 Check CMU reboot, current capture and retained records' \
            '3 Finish capture and save logs plus startup diagnostics to this USB' \
            '4 Uninstall (keeps collected logs)' \
            '5 Reboot CMU now through the original system reboot command' \
            '6 Delete everything this package left on the CMU (run 4, then 5, first)' \
            '7 VIM side-channel log on/off (log only)' \
            '8 Heading (G3) log and start bearing on/off' \
            '9 Tunnel test on/off (BETA diagnostic)' \
            '10 Tunnel 25 m cap on/off (BETA)' \
            '11 Phone IMU Bluetooth on/off (record only)' \
            '0 Exit'
        echo "$start_text"
        echo 'Installation and CMU reboot: remain parked with the engine actually running (not ACC or engine-off ON). Do not press the engine start/stop button during these steps.'
    fi
    printf 'Number, then Enter: '
    if ! IFS= read -r choice; then exit "$last_rc"; fi
    case "$choice" in
        1) sh "$HERE/install.sh"; last_rc=0
           echo "$installed_text";;
        2) current_status;;
        3) finish_and_export; exit 0;;
        4) sh "$HERE/uninstall.sh"; exit 0;;
        5) require_usb; sh "$HERE/reboot_cmu.sh"; exit 0;;
        6) require_usb
           # Menu 6 deletes the collected logs too: a second explicit 6 is
           # required (any other line, an empty line or EOF cancels).
           printf '%s\n' 'Menu 6 deletes the collected logs too.' \
               'Run 3 first to save them to this USB.' \
               'Enter 6 again to delete everything,' \
               'anything else cancels.'
           printf 'Number, then Enter: '
           if ! IFS= read -r confirm; then echo 'Cancelled; nothing deleted.'; exit "$last_rc"; fi
           if [ "$confirm" != 6 ]; then echo 'Cancelled; nothing deleted.'; continue; fi
           sh "$HERE/purge.sh" "$HERE"; exit 0;;
        7) if ! vim_side_toggle; then exit "$last_rc"; fi;;
        8) if ! g3_toggle; then exit "$last_rc"; fi;;
        9) if ! diag_toggle; then exit "$last_rc"; fi;;
        10) if ! acc_cap_toggle; then exit "$last_rc"; fi;;
        11) if ! bt_toggle; then exit "$last_rc"; fi;;
        0) exit "$last_rc";;
        *) echo 'Enter one of the listed numbers; no action taken.';;
    esac
done
